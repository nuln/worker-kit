{
  "name": "@nuln/worker-kit",
  "version": "0.1.0",
  "description": "Unified core toolkit for Cloudflare Workers in Nuln ecosystem (SSO, UI Design Tokens, Crypto, Session, HTTP Helpers)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sso": "./src/sso/index.ts",
    "./ui": "./src/ui/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./session": "./src/session/index.ts",
    "./http": "./src/http/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "cloudflare-workers",
    "worker-kit",
    "oidc",
    "sso",
    "design-tokens",
    "crypto",
    "nuln"
  ],
  "author": "Nuln Team",
  "license": "MIT"
}
